:root {
    --rosa-principal: #db7093;
    --rosa-claro: #fff5f7;
    --dorado: #d4af37;
    --oscuro: #333;
}

body {
    background-color: var(--rosa-claro);
    font-family: 'Poppins', sans-serif;
    color: var(--oscuro);
}

h1, h2, h5 { font-family: 'Playfair Display', serif; }

/* ---- Hero ---- */
.hero-section {
    padding: 60px 0;
    background: linear-gradient(rgba(255,245,247,0.8), rgba(255,245,247,0.8)),
                url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&q=80&w=1000');
    background-size: cover;
    background-position: center;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--rosa-principal);
}
.logo-container img {
    max-height: 180px;
    filter: drop-shadow(0 5px 15px rgba(0,0,0,0.1));
}
.btn-ver-catalogo {
    display: inline-block;
    background: var(--rosa-principal);
    color: white;
    border-radius: 50px;
    padding: 12px 32px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.3s;
}
.btn-ver-catalogo:hover {
    background: #c0567a;
    color: white;
    box-shadow: 0 8px 20px rgba(219, 112, 147, 0.35);
    transform: translateY(-2px);
}

/* ---- Filtros de categoría ---- */
.filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 30px;
}
.filtro-btn {
    border: 1.5px solid var(--rosa-principal);
    background: white;
    color: var(--rosa-principal);
    border-radius: 50px;
    padding: 6px 18px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.25s;
    cursor: pointer;
}
.filtro-btn:hover { background: var(--rosa-claro); }
.filtro-btn.activo {
    background: var(--rosa-principal);
    color: white;
}

/* ---- Tarjetas de producto ---- */
.card {
    border: none;
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background: white;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
}
.card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(219, 112, 147, 0.2);
}

.img-wrapper {
    width: 100%;
    height: 350px;
    background-color: #fff;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
}
.card-img-top {
    width: 100%;
    height: 350px;
    object-fit: contain;
    padding: 10px;
    transition: transform 0.5s;
}
.card:hover .card-img-top { transform: scale(1.05); }

.price-tag {
    color: var(--rosa-principal);
    font-weight: 600;
    font-size: 1.4rem;
    margin-bottom: 10px;
    display: block;
}

.btn-whatsapp {
    background-color: var(--rosa-principal);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 12px 25px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s;
    text-decoration: none;
    display: block;
    text-align: center;
}
.btn-whatsapp:hover {
    background-color: #c0567a;
    color: white;
    box-shadow: 0 5px 15px rgba(219, 112, 147, 0.4);
}

.badge-new {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--dorado);
    color: white;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 0.8rem;
    z-index: 10;
}
.badge-agotado {
    background: #999;
}

/* ---- Producto agotado ---- */
.card-agotada .img-wrapper img {
    filter: grayscale(60%);
    opacity: 0.7;
}
.btn-whatsapp-disabled {
    background-color: #ccc;
    color: #777;
    cursor: not-allowed;
}

/* ---- Estado vacío / carga ---- */
#estado-catalogo {
    text-align: center;
    padding: 40px 0;
    color: #888;
}

/* ---- Footer oscuro y elegante ---- */
.footer-oscuro {
    background: #241b1e;
    color: #e8dfe1;
}
.footer-marca {
    color: var(--rosa-principal);
    font-family: 'Playfair Display', serif;
}
.footer-titulo {
    color: white;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 0.85rem;
}
.footer-texto {
    color: #b8a9ad;
    font-size: 0.92rem;
}
.footer-link {
    color: #d8c6cb;
    text-decoration: none;
    transition: color 0.2s;
}
.footer-link:hover {
    color: var(--rosa-principal);
}
.footer-linea {
    border-color: rgba(255,255,255,0.1);
}
.footer-redes {
    display: flex;
    gap: 12px;
}
.footer-red-icono {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    color: #e8dfe1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: all 0.25s;
}
.footer-red-icono:hover {
    background: var(--color-red, var(--rosa-principal));
    color: white;
    transform: translateY(-3px);
}

/* ---- Modal / lightbox de imagen ---- */
.lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(20, 12, 14, 0.9);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.lightbox-overlay.activo {
    display: flex;
}
.lightbox-contenido {
    background: white;
    border-radius: 16px;
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    text-align: center;
    animation: lightbox-in 0.25s ease;
}
@keyframes lightbox-in {
    from { transform: scale(0.92); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}
.lightbox-imagen {
    width: 100%;
    max-height: 60vh;
    object-fit: contain;
    background: #fff;
    display: block;
}
.lightbox-info {
    padding: 20px 25px 25px;
}
.lightbox-cerrar {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    color: white;
    border: none;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
}
.lightbox-cerrar:hover { background: var(--rosa-principal); }

/* ---- Botón flotante de WhatsApp ---- */
.whatsapp-flotante {
    position: fixed;
    bottom: 22px;
    right: 22px;
    background: #25d366;
    color: white;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.25);
    z-index: 1000;
    transition: transform 0.25s;
}
.whatsapp-flotante:hover {
    transform: scale(1.08);
    color: white;
}
